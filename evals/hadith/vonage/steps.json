{
  "platform": "hadith",
  "provider": "vonage",
  "server": "dotnet",
  "steps": [
    {
      "step": 1,
      "title": "Open a webhook listen session (24t listen)",
      "code": "node 24t.mjs listen --forward-to http://localhost:3040/24t/webhooks",
      "screenshot": null,
      "result": "signing secret printed (kept in the server env only)",
      "ok": true,
      "seconds": 0.6
    },
    {
      "step": 2,
      "title": "Start the dotnet server with VIDEO_PROVIDER=vonage",
      "code": "dotnet run --no-build --project servers/dotnet",
      "screenshot": null,
      "result": {
        "slug": "hadith",
        "name": "Hadith Care",
        "provider": "webrtc",
        "colours": {
          "primary": "#6C3FC9",
          "ink": "#22114A",
          "surface": "#F7F3FF"
        },
        "logo": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dotnetcore/dotnetcore-original.svg",
        "patientRecorder": false
      },
      "ok": true,
      "seconds": 0
    },
    {
      "step": 3,
      "title": "Therapist opens the room in the platform colours",
      "code": "GET http://localhost:3040/",
      "screenshot": "03.webp",
      "result": {
        "title": "Hadith Care"
      },
      "ok": true,
      "seconds": 0.5
    },
    {
      "step": 4,
      "title": "Start the session (subject + session through the server kit)",
      "code": "POST /api/start -> putClinician, createSubject, createSession",
      "screenshot": "04.webp",
      "result": {
        "session": "ses_f0d119cf612f4a2fa53779ec24662b2c",
        "status": "awaiting_consent"
      },
      "ok": true,
      "seconds": 1.2
    },
    {
      "step": 5,
      "title": "Patient opens the consent page",
      "code": "patient_consent_url (link hidden)",
      "screenshot": "05.webp",
      "result": [
        "هل نسجّل الجلسة ليتذكّرها معالجك في المرة القادمة؟",
        "عمري 18+"
      ],
      "ok": true,
      "seconds": 2
    },
    {
      "step": 6,
      "title": "Patient says yes",
      "code": "click نعم (yes)",
      "screenshot": "06.webp",
      "result": [
        "English",
        "هل نسجّل الجلسة ليتذكّرها معالجك في المرة القادمة؟",
        "عمري 18+"
      ],
      "ok": true,
      "seconds": 1.6
    },
    {
      "step": 7,
      "title": "Both join the call; the recorder sees consent and records",
      "code": "Providers.vonage.join + createRecorder",
      "screenshot": "07.webp",
      "result": {
        "recorder": "recording",
        "remote_video": true,
        "video_error": null
      },
      "ok": true,
      "seconds": 2.4
    },
    {
      "step": 8,
      "title": "Therapist widget in the call (live transcript)",
      "code": "K.mount(el, { launch: K.widgetLauncher('/24t', { view: 'session', session }) })",
      "screenshot": "08.webp",
      "result": {
        "ready": true
      },
      "ok": true,
      "seconds": 0.2
    }
  ]
}